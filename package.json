{
  "name": "free-video-upscaler",
  "version": "0.2.0",
  "description": "Free tool to upscale videos in the browser using Real-ESRGAN",
  "main": "src/main.js",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack serve --mode development",
    "serve": "webpack serve --mode development",
    "type-check": "tsc --noEmit",
    "benchmark:tiling": "node scripts/benchmark-tiling.cjs",
    "verify:onnx-rewrite": "node scripts/verify-onnx-rewrite.cjs",
    "benchmark:webgpu": "webpack --config scripts/gpu-benchmark.webpack.cjs --mode development",
    "benchmark:clip": "webpack --config scripts/clip-regression.webpack.cjs --mode development"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sb2702/free-ai-video-upscaler.git"
  },
  "author": "Sam Bhattacharyya",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sb2702/free-ai-video-upscaler/issues"
  },
  "homepage": "https://github.com/sb2702/free-ai-video-upscaler#readme",
  "dependencies": {
    "@babel/core": "^7.1.6",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@popperjs/core": "^2.11.8",
    "alpinejs": "3.4.2",
    "babel-loader": "^9.1.3",
    "bootstrap": "^5.3.2",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "html-webpack-plugin": "^5.5.4",
    "jquery": "^3.7.1",
    "mediabunny": "^1.27.0",
    "mp4-muxer": "^3.0.2",
    "mp4box": "^0.5.2",
    "onnxruntime-web": "^1.20.0",
    "popper.js": "^1.16.1",
    "protobufjs": "^7.5.4",
    "style-loader": "^3.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@webgpu/types": "^0.1.69",
    "autoprefixer": "^10.4.21",
    "css-loader": "^6.8.1",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.1.1",
    "tailwindcss": "^3.4.17",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3"
  }
}
